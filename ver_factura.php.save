```php
<?php

session_start();

require_once 'config.php';

/* ==========================================
   OBTENER ID
========================================== */

$facturaId = filter_input(
    INPUT_GET,
    'id',
    FILTER_VALIDATE_INT
);

if (!$facturaId || $facturaId <= 0) {
    header('Location: facturas.php');
    exit;
}

/* ==========================================
   SEGURIDAD
========================================== */

if (!isset($_SESSION['usuario_id'])) {

    http_response_code(401);

    echo '
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Acceso no permitido | ViziuneAI</title>
        <link rel="stylesheet" href="css/ver-factura.css">
    </head>
    <body>
        <div class="error-factura">
            <h1>Acceso no permitido</h1>
            <p>
                Debes iniciar sesión para consultar esta factura.
            </p>
            <a href="login.php" class="boton boton-principal">
                ← Iniciar sesión
            </a>
        </div>
    </body>
    </html>
    ';

    exit;
}

$usuarioId = (int) $_SESSION['usuario_id'];

if ($usuarioId <= 0) {

    http_response_code(403);

    echo '
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Acceso no permitido | ViziuneAI</title>
        <link rel="stylesheet" href="css/ver-factura.css">
    </head>
    <body>
        <div class="error-factura">
            <h1>Acceso no permitido</h1>
            <p>
                No tienes permiso para consultar esta factura.
            </p>
            <a href="mi_cuenta.php" class="boton boton-principal">
                ← Volver a mi cuenta
            </a>
        </div>
    </body>
    </html>
    ';

    exit;
}

/* ==========================================
   OBTENER FACTURA TÉCNICA
========================================== */

$stmtFactura = $pdo->prepare("
    SELECT
        f.id,
        f.cliente_id,
        f.estado,
        f.created_at,
        f.updated_at
    FROM facturas f
    INNER JOIN clientes c
        ON c.id = f.cliente_id
    WHERE f.id = ?
      AND c.usuario_id = ?
      AND c.activo = 1
    LIMIT 1
");

$stmtFactura->execute([
    $facturaId,
    $usuarioId
]);

$facturaTecnica = $stmtFactura->fetch();

/* ==========================================
   FACTURA NO ENCONTRADA / SIN PERMISO
========================================== */

if (!$facturaTecnica) {

    http_response_code(403);

    echo '
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Acceso no permitido | ViziuneAI</title>
        <link rel="stylesheet" href="css/ver-factura.css">
    </head>
    <body>
        <div class="error-factura">
            <h1>Acceso no permitido</h1>
            <p>
                No tienes permiso para consultar esta factura.
            </p>
            <a href="facturas.php" class="boton boton-principal">
                ← Volver a facturas
            </a>
        </div>
    </body>
    </html>
    ';

    exit;
}

/* ==========================================
   COMPROBAR SODIUM
========================================== */

if (!function_exists('sodium_crypto_secretbox_open')) {

    http_response_code(500);

    echo '
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Error | ViziuneAI</title>
        <link rel="stylesheet" href="css/ver-factura.css">
    </head>
    <body>
        <div class="error-factura">
            <h1>Error interno</h1>
            <p>
                El sistema de cifrado de facturas no está disponible.
            </p>
        </div>
    </body>
    </html>
    ';

    exit;
}

/* ==========================================
   OBTENER CLAVE DE CIFRADO
========================================== */

$claveCifrado = getenv('VIZIUNEAI_FACTURAS_KEY');

if (!$claveCifrado) {

    http_response_code(500);

    echo '
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Error | ViziuneAI</title>
        <link rel="stylesheet" href="css/ver-factura.css">
    </head>
    <body>
        <div class="error-factura">
            <h1>Error interno</h1>
            <p>
                No está configurada la clave de cifrado de las facturas.
            </p>
        </div>
    </body>
    </html>
    ';

    exit;
}

if (strlen($claveCifrado) < 32) {

    http_response_code(500);

    echo '
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Error | ViziuneAI</title>
        <link rel="stylesheet" href="css/ver-factura.css">
    </head>
    <body>
        <div class="error-factura">
            <h1>Error interno</h1>
            <p>
                La clave de cifrado configurada no es suficientemente segura.
            </p>
        </div>
    </body>
    </html>
    ';

    exit;
}

$clave = hash('sha256', $claveCifrado, true);

/* ==========================================
   OBTENER DATOS PRIVADOS CIFRADOS
========================================== */

$stmtPrivada = $pdo->prepare("
    SELECT
        datos_cifrados
    FROM facturas_privadas
    WHERE factura_id = ?
      AND usuario_id = ?
    LIMIT 1
");

$stmtPrivada->execute([
    $facturaId,
    $usuarioId
]);

$facturaPrivada = $stmtPrivada->fetch();

if (!$facturaPrivada || empty($facturaPrivada['datos_cifrados'])) {

    http_response_code(404);

    echo '
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Factura no disponible | ViziuneAI</title>
        <link rel="stylesheet" href="css/ver-factura.css">
    </head>
    <body>
        <div class="error-factura">
            <h1>Factura no disponible</h1>
            <p>
                Los datos privados de esta factura no están disponibles.
            </p>
            <a href="facturas.php" class="boton boton-principal">
                ← Volver a facturas
            </a>
        </div>
    </body>
    </html>
    ';

    exit;
}

/* ==========================================
   DESCIFRAR FACTURA
========================================== */

$contenidoCifrado = base64_decode(
    $facturaPrivada['datos_cifrados'],
    true
);

if ($contenidoCifrado === false) {

    http_response_code(500);

    echo '
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Error | ViziuneAI</title>
        <link rel="stylesheet" href="css/ver-factura.css">
    </head>
    <body>
        <div class="error-factura">
            <h1>Error interno</h1>
            <p>
                No se han podido leer los datos de la factura.
            </p>
        </div>
    </body>
    </html>
    ';

    exit;
}

$nonceBytes = SODIUM_CRYPTO_SECRETBOX_NONCEBYTES;

if (strlen($contenidoCifrado) <= $nonceBytes) {

    http_response_code(500);

    echo '
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Error | ViziuneAI</title>
        <link rel="stylesheet" href="css/ver-factura.css">
    </head>
    <body>
        <div class="error-factura">
            <h1>Error interno</h1>
            <p>
                Los datos de la factura están dañados.
            </p>
        </div>
    </body>
    </html>
    ';

    exit;
}

$nonce = substr(
    $contenidoCifrado,
    0,
    $nonceBytes
);

$cifrado = substr(
    $contenidoCifrado,
    $nonceBytes
);

$jsonFactura = sodium_crypto_secretbox_open(
    $cifrado,
    $nonce,
    $clave
);

if ($jsonFactura === false) {

    http_response_code(500);

    echo '
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Error | ViziuneAI</title>
        <link rel="stylesheet" href="css/ver-factura.css">
    </head>
    <body>
        <div class="error-factura">
            <h1>Error interno</h1>
            <p>
                No se han podido descifrar los datos de la factura.
            </p>
        </div>
    </body>
    </html>
    ';

    exit;
}

$datosPrivados = json_decode(
    $jsonFactura,
    true
);

if (!is_array($datosPrivados)) {

    http_response_code(500);

    echo '
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Error | ViziuneAI</title>
        <link rel="stylesheet" href="css/ver-factura.css">
    </head>
    <body>
        <div class="error-factura">
            <h1>Error interno</h1>
            <p>
                El formato de los datos de la factura no es válido.
            </p>
        </div>
    </body>
    </html>
    ';

    exit;
}

/* ==========================================
   RECONSTRUIR FACTURA
========================================== */

$cliente = $datosPrivados['cliente'] ?? [];

$factura = [
    'id' => $facturaTecnica['id'],
    'cliente_id' => $facturaTecnica['cliente_id'],
    'serie' => $datosPrivados['serie'] ?? null,
    'numero' => $datosPrivados['numero'] ?? null,
    'fecha_emision' => $datosPrivados['fecha_emision'] ?? null,
    'moneda' => $datosPrivados['moneda'] ?? 'EUR',
    'base_imponible' => $datosPrivados['base_imponible'] ?? 0,
    'total_iva' => $datosPrivados['total_iva'] ?? 0,
    'total_irpf' => $datosPrivados['total_irpf'] ?? 0,
    'total' => $datosPrivados['total'] ?? 0,
    'metodo_pago' => $datosPrivados['metodo_pago'] ?? null,
    'fecha_vencimiento' => $datosPrivados['fecha_vencimiento'] ?? null,
    'observaciones' => $datosPrivados['observaciones'] ?? null,
    'estado' => $facturaTecnica['estado'],
    'created_at' => $facturaTecnica['created_at'],
    'updated_at' => $facturaTecnica['updated_at'],

    'nombre_razon_social' =>
        $cliente['nombre_razon_social'] ?? '',

    'nif' =>
        $cliente['nif'] ?? '',

    'direccion' =>
        $cliente['direccion'] ?? '',

    'codigo_postal' =>
        $cliente['codigo_postal'] ?? '',

    'ciudad' =>
        $cliente['ciudad'] ?? '',

    'provincia' =>
        $cliente['provincia'] ?? '',

    'pais' =>
        $cliente['pais'] ?? '',

    'email' =>
        $cliente['email'] ?? '',

    'telefono' =>
        $cliente['telefono'] ?? ''
];

/* ==========================================
   OBTENER LÍNEAS DESDE LOS DATOS CIFRADOS
========================================== */

$lineas = [];

if (
    isset($datosPrivados['lineas']) &&
    is_array($datosPrivados['lineas'])
) {
    $lineas = $datosPrivados['lineas'];
}

/* ==========================================
   DATOS DE LA EMPRESA
========================================== */

$stmtEmpresa = $pdo->query("
    SELECT
        razon_social,
        nif,
        direccion,
        codigo_postal,
        ciudad,
        provincia,
        pais,
        email,
        telefono,
        web,
        iban,
        logo
    FROM empresa_facturacion
    ORDER BY id ASC
    LIMIT 1
");

$empresa = $stmtEmpresa->fetch();

/* ==========================================
   NUMERO DE FACTURA
========================================== */

if (
    $factura['numero'] !== null &&
    $factura['numero'] !== ''
) {

    $numeroFactura =
        $factura['serie'] .
        '-' .
        $factura['numero'];

} else {

    $numeroFactura = 'BORRADOR';
}

/* ==========================================
   FECHAS
========================================== */

$fechaEmision = '';

if (!empty($factura['fecha_emision'])) {

    $fechaEmision = date(
        'd/m/Y',
        strtotime($factura['fecha_emision'])
    );
}

$fechaVencimiento = '';

if (!empty($factura['fecha_vencimiento'])) {

    $fechaVencimiento = date(
        'd/m/Y',
        strtotime($factura['fecha_vencimiento'])
    );
}

/* ==========================================
   ESTADO
========================================== */

$estado = $factura['estado'];

$estadoTexto = 'Borrador';

if ($estado === 'emitida') {

    $estadoTexto = 'Emitida';

} elseif ($estado === 'anulada') {

    $estadoTexto = 'Anulada';
}

/* ==========================================
   MENSAJE GUARDADA
========================================== */

$guardada =
    isset($_GET['guardada']) &&
    $_GET['guardada'] === '1';

/* ==========================================
   FUNCIONES
========================================== */

function h($valor)
{
    return htmlspecialchars(
        (string) $valor,
        ENT_QUOTES,
        'UTF-8'
    );
}

function dinero($valor)
{
    return number_format(
        (float) $valor,
        2,
        ',',
        '.'
    ) . ' €';
}

?>

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <?php echo h($numeroFactura); ?> |
        ViziuneAI
    </title>

    <link
        rel="stylesheet"
        href="css/ver-factura.css"
    >

</head>

<body>

<div class="contenedor-factura">

    <!-- ======================================
         BARRA SUPERIOR
    ====================================== -->

    <div class="barra-superior">

        <h1>
            Factura <?php echo h($numeroFactura); ?>
        </h1>

        <div class="navegacion">

            <a
                href="facturas.php"
                class="boton"
            >
                ← Facturas
            </a>

            <?php if ($estado === 'borrador'): ?>

